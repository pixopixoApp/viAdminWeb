{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtime.pixo.app/contracts/bridge-v1.schema.json",
  "title": "Pixo Native Bridge v1",
  "description": "Canonical v/kind/method/params RPC envelopes, capability events, Runtime events, and lifecycle payloads shared by Android, iOS, and browser hosts.",
  "oneOf": [
    { "$ref": "#/$defs/requestEnvelope" },
    { "$ref": "#/$defs/responseEnvelope" },
    { "$ref": "#/$defs/capabilityEventEnvelope" },
    { "$ref": "#/$defs/runtimeEventEnvelope" },
    { "$ref": "#/$defs/hostState" }
  ],
  "$defs": {
    "bridgeVersion": { "const": 1 },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "denied",
        "active",
        "activity",
        "matched",
        "paused",
        "stopped",
        "preview",
        "unavailable",
        "error",
        "played",
        "applied",
        "presented",
        "copied",
        "copy_failed"
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "deviceInfo",
        "requestCapability",
        "startMotion",
        "stopMotion",
        "startMicrophoneLevel",
        "stopMicrophoneLevel",
        "startCameraSignals",
        "stopCameraSignals",
        "startVision",
        "stopVision",
        "haptic",
        "mediaControl",
        "shareExperience"
      ]
    },
    "capabilityName": {
      "type": "string",
      "enum": [
        "motion",
        "orientation",
        "tilt",
        "gyro",
        "shake",
        "microphone",
        "microphoneLevel",
        "camera",
        "cameraSignals",
        "vision",
        "haptics",
        "deviceInfo",
        "mediaControl"
      ]
    },
    "requestEnvelope": {
      "type": "object",
      "required": ["v", "kind", "id", "method", "params"],
      "properties": {
        "v": { "$ref": "#/$defs/bridgeVersion" },
        "kind": { "const": "request" },
        "id": { "$ref": "#/$defs/requestId" },
        "method": { "$ref": "#/$defs/method" },
        "params": { "type": "object" },
        "action": {
          "description": "Temporary Android compatibility mirror of method.",
          "$ref": "#/$defs/method"
        },
        "payload": {
          "description": "Temporary Android compatibility mirror of params.",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "method": { "const": "requestCapability" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "$ref": "#/$defs/capabilityName" }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "startMicrophoneLevel" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "processing_profile": {
                    "type": "string",
                    "enum": ["continuous_blow_v1", "continuous_voice_v1"]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "responseEnvelope": {
      "type": "object",
      "required": ["v", "kind", "id", "ok"],
      "properties": {
        "v": { "$ref": "#/$defs/bridgeVersion" },
        "kind": { "const": "response" },
        "id": { "$ref": "#/$defs/requestId" },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "message": { "type": "string", "minLength": 1, "maxLength": 512 },
            "details": {}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
          "then": { "required": ["result"] },
          "else": { "required": ["error"] }
        }
      ]
    },
    "runtimeEventEnvelope": {
      "type": "object",
      "required": ["v", "kind", "data"],
      "properties": {
        "v": { "$ref": "#/$defs/bridgeVersion" },
        "kind": { "const": "runtime_event" },
        "data": { "$ref": "#/$defs/runtimeEvent" }
      },
      "additionalProperties": false
    },
    "operationResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": true
    },
    "deviceInfo": {
      "type": "object",
      "required": ["platform", "app"],
      "properties": {
        "platform": { "type": "string", "enum": ["android", "ios", "web"] },
        "app": { "const": "Pixo" },
        "bridge_version": { "$ref": "#/$defs/bridgeVersion" },
        "supportsMotion": { "type": "boolean" },
        "supportsMicrophoneLevel": { "type": "boolean" },
        "supportsCameraPermission": { "type": "boolean" },
        "supportsCameraSignals": { "type": "boolean" },
        "supportsHaptics": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "sessionId": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "motionSignal": {
      "type": "object",
      "required": ["timestamp", "alpha", "beta", "gamma"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "timestamp": { "type": "number", "minimum": 0 },
        "alpha": { "type": "number" },
        "beta": { "type": "number" },
        "gamma": { "type": "number" },
        "acceleration_x": { "type": "number" },
        "acceleration_y": { "type": "number" },
        "acceleration_z": { "type": "number" },
        "acceleration_magnitude": { "type": "number", "minimum": 0 },
        "motion_score": { "$ref": "#/$defs/score100" },
        "shake_score": { "$ref": "#/$defs/score100" }
      },
      "additionalProperties": false
    },
    "microphoneSignal": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "timestamp": { "type": "number", "minimum": 0 },
        "level": { "$ref": "#/$defs/unitInterval" },
        "rms": { "$ref": "#/$defs/unitInterval" },
        "peak": { "$ref": "#/$defs/unitInterval" },
        "rms_dbfs": { "type": "number", "maximum": 0 },
        "peak_dbfs": { "type": "number", "maximum": 0 },
        "score": { "$ref": "#/$defs/score100" },
        "volume_score": { "$ref": "#/$defs/score100" },
        "instant_score": { "$ref": "#/$defs/score100" },
        "peak_score": { "$ref": "#/$defs/score100" },
        "transient_score": { "$ref": "#/$defs/score100" },
        "noise_score": { "$ref": "#/$defs/score100" },
        "zero_crossing_rate": { "$ref": "#/$defs/unitInterval" },
        "low_frequency_ratio": { "$ref": "#/$defs/unitInterval" },
        "pitch_hz": { "type": "number", "minimum": 0, "maximum": 2000 },
        "pitch_confidence": { "$ref": "#/$defs/score100" },
        "analysis_window_ms": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "emit_interval_ms": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "audio_source": { "type": "string", "minLength": 1 },
        "sample_rate_hz": { "type": "integer", "minimum": 8000, "maximum": 192000 },
        "unprocessed_supported": { "type": "boolean" },
        "processing_profile": {
          "type": "string",
          "enum": ["legacy", "continuous_blow_v1", "continuous_voice_v1"]
        },
        "echo_canceler_available": { "type": "boolean" },
        "echo_canceler_enabled": { "type": "boolean" },
        "detector": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "active" } },
            "required": ["status"]
          },
          "then": {
            "required": ["timestamp", "rms", "peak", "score", "volume_score"]
          }
        }
      ]
    },
    "cameraSignal": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "timestamp": { "type": "number", "minimum": 0 },
        "brightness": { "$ref": "#/$defs/unitInterval" },
        "motionLevel": { "$ref": "#/$defs/unitInterval" },
        "faceCount": { "type": "integer", "minimum": 0 },
        "faceCenter": {
          "oneOf": [
            {
              "type": "object",
              "maxProperties": 0
            },
            {
              "type": "object",
              "properties": {
                "x": { "$ref": "#/$defs/unitInterval" },
                "y": { "$ref": "#/$defs/unitInterval" }
              },
              "required": ["x", "y"],
              "additionalProperties": false
            }
          ]
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "active" } },
            "required": ["status"]
          },
          "then": {
            "required": ["timestamp", "brightness", "motionLevel", "faceCount"]
          }
        }
      ]
    },
    "visionSignal": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "timestamp": { "type": "number", "minimum": 0 },
        "target": { "type": "string", "minLength": 1, "maxLength": 80 },
        "confidence": { "$ref": "#/$defs/unitInterval" },
        "reason": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1, "maxLength": 160 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["activity", "matched"] } },
            "required": ["status"]
          },
          "then": { "required": ["timestamp", "target"] }
        }
      ]
    },
    "capabilityEventEnvelope": {
      "type": "object",
      "required": ["v", "kind", "name", "data"],
      "properties": {
        "v": { "$ref": "#/$defs/bridgeVersion" },
        "kind": { "const": "event" },
        "name": {
          "type": "string",
          "enum": ["motion", "microphoneLevel", "cameraSignals", "vision"]
        },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "data": { "type": "object" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "name": { "const": "motion" } }, "required": ["name"] },
          "then": { "properties": { "data": { "$ref": "#/$defs/motionSignal" } } }
        },
        {
          "if": { "properties": { "name": { "const": "microphoneLevel" } }, "required": ["name"] },
          "then": { "properties": { "data": { "$ref": "#/$defs/microphoneSignal" } } }
        },
        {
          "if": { "properties": { "name": { "const": "cameraSignals" } }, "required": ["name"] },
          "then": { "properties": { "data": { "$ref": "#/$defs/cameraSignal" } } }
        },
        {
          "if": { "properties": { "name": { "const": "vision" } }, "required": ["name"] },
          "then": { "properties": { "data": { "$ref": "#/$defs/visionSignal" } } }
        }
      ]
    },
    "runtimeEvent": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "ready",
            "mediaReady",
            "started",
            "gateOpened",
            "gateResolved",
            "gateFallback",
            "resultActionDeferred",
            "resultActionExecuted",
            "segmentChanged",
            "replay",
            "hostStateChanged",
            "playbackStateChanged",
            "ended",
            "error",
            "stateSnapshot"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "itemId": { "type": ["string", "null"] },
        "videoId": { "type": ["string", "null"] },
        "cueId": { "type": ["string", "null"] },
        "activationId": { "type": ["string", "null"] },
        "segmentIndex": { "type": ["integer", "null"], "minimum": 0 },
        "type": { "type": ["string", "null"] },
        "outcome": {
          "type": ["string", "null"],
          "enum": ["success", "miss", "timeout", "skipped", null]
        },
        "resultAction": {
          "type": ["string", "null"],
          "enum": ["continue", "retry_previous_point", "restart_video", "jump_video", "end_experience", null]
        },
        "targetVideoId": { "type": ["string", "null"] },
        "timing": {
          "type": ["string", "null"],
          "enum": ["immediate", "video_end", null]
        },
        "deferred": { "type": "boolean" },
        "interactionActive": { "type": "boolean" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hostState": {
      "type": "object",
      "required": ["active", "allowAudio"],
      "properties": {
        "active": { "type": "boolean" },
        "allowAudio": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "score100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  }
}

FROM node:20-bookworm-slim AS admin-build

RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*
COPY apt.sources /etc/apt/sources.list.d/debian.sources
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl wget ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY admin/package.json admin/package-lock.json ./
# npm can omit Rollup's Linux optional binary when this lockfile was created on macOS.
# Install the matching pinned binary in the Linux build image without changing the source lockfile.
RUN npm config set registry https://registry.npmmirror.com \
  && npm ci \
  && case "$(uname -m)" in \
    x86_64) rollup_package='@rollup/rollup-linux-x64-gnu@4.62.4' ;; \
    aarch64|arm64) rollup_package='@rollup/rollup-linux-arm64-gnu@4.62.4' ;; \
    *) echo "Unsupported Linux CPU: $(uname -m)" >&2; exit 1 ;; \
  esac \
  && npm install --no-save --no-package-lock "$rollup_package"
COPY admin/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=admin-build /app/dist /usr/share/nginx/html
COPY player /usr/share/nginx/player
RUN cp /usr/share/nginx/player/player.html /usr/share/nginx/player/index.html
